<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- A placeholder: CI packs each release with -p:Version from scripts/version.ts, and the v<version> tags are the source of truth. -->
        <VersionPrefix>0.0.0</VersionPrefix>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Logdash</PackageId>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/logdash-io/dotnet-sdk</PackageProjectUrl>
        <RepositoryUrl>https://github.com/logdash-io/dotnet-sdk</RepositoryUrl>
        <Authors>JakubK</Authors>
        <RepositoryType>git</RepositoryType>
        <Description>Simple .NET Client for Logdash</Description>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.21" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.21" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath=""/>
    </ItemGroup>
</Project>
